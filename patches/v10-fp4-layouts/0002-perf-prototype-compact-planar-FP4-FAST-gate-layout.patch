 #else
     const uint32_t qs = pack32(u8vec4(data_a[ib].qs[iqs * 4    ],
@@ -172,7 +174,13 @@ void block_a_to_shmem(const uint buf_ib, const uint ib, const uint iqs) {
         buf_a[buf_ib].d = FLOAT_TYPEV2(ue4m3_to_fp32(data_a[ib].e[0]),
