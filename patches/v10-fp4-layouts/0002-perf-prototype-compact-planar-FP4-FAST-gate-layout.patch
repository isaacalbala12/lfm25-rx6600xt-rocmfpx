@@ -8092,6 +8097,12 @@ static bool ggml_vk_rocmfp4_fast_is_padded_gateup(const ggml_tensor * tensor) {
            tensor->ne[0] == 2048 && tensor->ne[1] == 10752;
 }
 
+static bool ggml_vk_rocmfp4_fast_is_planar_gateup(const ggml_tensor * tensor) {
+    return vk_rocmfp4_fast_mmq_bk3_gateup_planar &&
+           tensor->type == GGML_TYPE_Q4_0_ROCMFP4_FAST &&
+           tensor->ne[0] == 2048 && tensor->ne[1] == 10752;
+}
+
 static void ggml_vk_rocmfp4_fast_expand_padded(uint8_t * dst, const uint8_t * src, size_t nblocks) {
     for (size_t ib = 0; ib < nblocks; ++ib) {
         const uint8_t * s = src + ib * ggml_vk_rocmfp4_fast_disk_block_size;
@@ -8111,6 +8122,24 @@ static void ggml_vk_rocmfp4_fast_pack_padded(uint8_t * dst, const uint8_t * src,
     }
 }
 
+static void ggml_vk_rocmfp4_fast_expand_planar(uint8_t * dst, const uint8_t * src, size_t nblocks) {
+    uint8_t * scales = dst + 16 * nblocks;
+    for (size_t ib = 0; ib < nblocks; ++ib) {
+        const uint8_t * s = src + ib * ggml_vk_rocmfp4_fast_disk_block_size;
+        memcpy(dst + ib * 16, s, 16);
+        scales[ib] = s[16];
+    }
+}
+
+static void ggml_vk_rocmfp4_fast_pack_planar(uint8_t * dst, const uint8_t * src, size_t nblocks) {
+    const uint8_t * scales = src + 16 * nblocks;
+    for (size_t ib = 0; ib < nblocks; ++ib) {
+        uint8_t * d = dst + ib * ggml_vk_rocmfp4_fast_disk_block_size;
+        memcpy(d, src + ib * 16, 16);
+        d[16] = scales[ib];
+    }
+}
+
 static int8_t ggml_vk_rocmfpx_fp6_decode_code(uint8_t code) {
     const int8_t mag = code & 31;
     return (code & 32) != 0 ? -(mag == 0 ? 32 : mag) : mag;
@@ -8435,6 +8464,38 @@ static void ggml_vk_rocmfp4_fast_read_padded_range(vk_buffer& src, size_t tensor
     memcpy(dst, packed.data() + offset - packed_offset, size);
 }
 
+static void ggml_vk_rocmfp4_fast_write_planar_range(vk_buffer& dst, size_t tensor_offset,
+                                                     const void * src, size_t offset, size_t size,
+                                                     size_t tensor_size) {
+    GGML_ASSERT(size > 0 && offset + size <= tensor_size);
+    GGML_ASSERT(tensor_size % ggml_vk_rocmfp4_fast_disk_block_size == 0);
+    const size_t nblocks = tensor_size / ggml_vk_rocmfp4_fast_disk_block_size;
+    std::vector<uint8_t> planar(tensor_size);
+    if (offset == 0 && size == tensor_size) {
+        ggml_vk_rocmfp4_fast_expand_planar(planar.data(), (const uint8_t *) src, nblocks);
+    } else {
+        std::vector<uint8_t> packed(tensor_size);
+        ggml_vk_buffer_read(dst, tensor_offset, planar.data(), tensor_size);
+        ggml_vk_rocmfp4_fast_pack_planar(packed.data(), planar.data(), nblocks);
+        memcpy(packed.data() + offset, src, size);
+        ggml_vk_rocmfp4_fast_expand_planar(planar.data(), packed.data(), nblocks);
+    }
+    ggml_vk_buffer_write(dst, tensor_offset, planar.data(), tensor_size);
+}
+
+static void ggml_vk_rocmfp4_fast_read_planar_range(vk_buffer& src, size_t tensor_offset,
+                                                    void * dst, size_t offset, size_t size,
+                                                    size_t tensor_size) {
+    GGML_ASSERT(size > 0 && offset + size <= tensor_size);
+    GGML_ASSERT(tensor_size % ggml_vk_rocmfp4_fast_disk_block_size == 0);
+    const size_t nblocks = tensor_size / ggml_vk_rocmfp4_fast_disk_block_size;
+    std::vector<uint8_t> planar(tensor_size);
+    std::vector<uint8_t> packed(tensor_size);
+    ggml_vk_buffer_read(src, tensor_offset, planar.data(), tensor_size);
+    ggml_vk_rocmfp4_fast_pack_planar(packed.data(), planar.data(), nblocks);
+    memcpy(dst, packed.data() + offset, size);
+}
