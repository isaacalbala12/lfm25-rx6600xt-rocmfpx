+        // This opt-in pipeline is selected only for M=10752, K=2048.
+        const uint nblocks = 688128;
+        const uint scale_word = data_a_planar[(nblocks << 2) + (ib >> 2)];
+        const uint scale_shift = 8 * (ib & 3);
