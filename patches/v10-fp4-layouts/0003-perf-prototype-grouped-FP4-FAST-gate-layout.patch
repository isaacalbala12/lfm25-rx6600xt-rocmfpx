            tensor->ne[0] == 2048 && tensor->ne[1] == 10752;
 }
 
+static bool ggml_vk_rocmfp4_fast_is_group4_gateup(const ggml_tensor * tensor) {
+    return vk_rocmfp4_fast_mmq_bk3_gateup_group4 &&
+           tensor->type == GGML_TYPE_Q4_0_ROCMFP4_FAST &&
+           tensor->ne[0] == 2048 && tensor->ne[1] == 10752;
+}
+
 static void ggml_vk_rocmfp4_fast_expand_padded(uint8_t * dst, const uint8_t * src, size_t nblocks) {
     for (size_t ib = 0; ib < nblocks; ++ib) {
         const uint8_t * s = src + ib * ggml_vk_rocmfp4_fast_disk_block_size;
@@ -8140,6 +8151,30 @@ static void ggml_vk_rocmfp4_fast_pack_planar(uint8_t * dst, const uint8_t * src,
     }
 }
 
+static void ggml_vk_rocmfp4_fast_expand_group4(uint8_t * dst, const uint8_t * src, size_t nblocks) {
+    GGML_ASSERT(nblocks % 4 == 0);
+    for (size_t group = 0; group < nblocks / 4; ++group) {
+        uint8_t * d = dst + group * 68;
+        for (size_t lane = 0; lane < 4; ++lane) {
+            const uint8_t * s = src + (group * 4 + lane) * ggml_vk_rocmfp4_fast_disk_block_size;
+            memcpy(d + lane * 16, s, 16);
+            d[64 + lane] = s[16];
+        }
+    }
+}
+
+static void ggml_vk_rocmfp4_fast_pack_group4(uint8_t * dst, const uint8_t * src, size_t nblocks) {
+    GGML_ASSERT(nblocks % 4 == 0);
+    for (size_t group = 0; group < nblocks / 4; ++group) {
+        const uint8_t * s = src + group * 68;
+        for (size_t lane = 0; lane < 4; ++lane) {
+            uint8_t * d = dst + (group * 4 + lane) * ggml_vk_rocmfp4_fast_disk_block_size;
+            memcpy(d, s + lane * 16, 16);
+            d[16] = s[64 + lane];
+        }
+    }
+}
+
 static int8_t ggml_vk_rocmfpx_fp6_decode_code(uint8_t code) {
     const int8_t mag = code & 31;
     return (code & 32) != 0 ? -(mag == 0 ? 32 : mag) : mag;
@@ -8496,6 +8531,38 @@ static void ggml_vk_rocmfp4_fast_read_planar_range(vk_buffer& src, size_t tensor
     memcpy(dst, packed.data() + offset, size);
 }
 
+static void ggml_vk_rocmfp4_fast_write_group4_range(vk_buffer& dst, size_t tensor_offset,
+                                                     const void * src, size_t offset, size_t size,
+                                                     size_t tensor_size) {
+    GGML_ASSERT(size > 0 && offset + size <= tensor_size);
+    GGML_ASSERT(tensor_size % ggml_vk_rocmfp4_fast_disk_block_size == 0);
+    const size_t nblocks = tensor_size / ggml_vk_rocmfp4_fast_disk_block_size;
+    std::vector<uint8_t> group4(tensor_size);
+    if (offset == 0 && size == tensor_size) {
+        ggml_vk_rocmfp4_fast_expand_group4(group4.data(), (const uint8_t *) src, nblocks);
+    } else {
+        std::vector<uint8_t> packed(tensor_size);
+        ggml_vk_buffer_read(dst, tensor_offset, group4.data(), tensor_size);
+        ggml_vk_rocmfp4_fast_pack_group4(packed.data(), group4.data(), nblocks);
+        memcpy(packed.data() + offset, src, size);
+        ggml_vk_rocmfp4_fast_expand_group4(group4.data(), packed.data(), nblocks);
+    }
+    ggml_vk_buffer_write(dst, tensor_offset, group4.data(), tensor_size);
+}
+
+static void ggml_vk_rocmfp4_fast_read_group4_range(vk_buffer& src, size_t tensor_offset,
+                                                    void * dst, size_t offset, size_t size,
+                                                    size_t tensor_size) {
+    GGML_ASSERT(size > 0 && offset + size <= tensor_size);
+    GGML_ASSERT(tensor_size % ggml_vk_rocmfp4_fast_disk_block_size == 0);
+    const size_t nblocks = tensor_size / ggml_vk_rocmfp4_fast_disk_block_size;
+    std::vector<uint8_t> group4(tensor_size);
+    std::vector<uint8_t> packed(tensor_size);
+    ggml_vk_buffer_read(src, tensor_offset, group4.data(), tensor_size);
+    ggml_vk_rocmfp4_fast_pack_group4(packed.data(), group4.data(), nblocks);
+    memcpy(dst, packed.data() + offset, size);
+}
+
