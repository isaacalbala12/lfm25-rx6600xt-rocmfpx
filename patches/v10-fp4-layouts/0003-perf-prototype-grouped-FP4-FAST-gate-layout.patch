 #if defined(DATA_A_MXFP4) || defined(DATA_A_ROCMFP4) || defined(DATA_A_ROCMFP4_FAST)
 // 1-byte quant loads for microscaled FP4 blocks. ROCmFP4 uses two compact half-block scales.
 void block_a_to_shmem(const uint buf_ib, const uint ib, const uint iqs) {
-#if defined(ROCMFP4_FAST_PLANAR) && defined(DATA_A_ROCMFP4_FAST)
+#if defined(ROCMFP4_FAST_GROUP4) && defined(DATA_A_ROCMFP4_FAST)
+    const uint block_group = ib >> 2;
+    const uint block_lane = ib & 3;
+    const uint32_t qs = data_a_group4[block_group * 17 + (block_lane << 2) + iqs];
+#elif defined(ROCMFP4_FAST_PLANAR) && defined(DATA_A_ROCMFP4_FAST)
     const uint32_t qs = data_a_planar[(ib << 2) + iqs];
 #elif defined(ROCMFP4_FAST_PADDED) && defined(DATA_A_ROCMFP4_FAST)
     const uint32_t qs = data_a_padded[ib].qs[iqs];
@@ -174,7 +178,12 @@ void block_a_to_shmem(const uint buf_ib, const uint ib, const uint iqs) {
         buf_a[buf_ib].d = FLOAT_TYPEV2(ue4m3_to_fp32(data_a[ib].e[0]),
                                        ue4m3_to_fp32(data_a[ib].e[1]));
 #elif defined(DATA_A_ROCMFP4_FAST)
-#if defined(ROCMFP4_FAST_PLANAR)
+#if defined(ROCMFP4_FAST_GROUP4)
+        const uint block_group = ib >> 2;
+        const uint block_lane = ib & 3;
+        const uint scale_word = data_a_group4[block_group * 17 + 16];
+        buf_a[buf_ib].d = FLOAT_TYPE(ue4m3_to_fp32(uint8_t(scale_word >> (8 * block_lane))));
+#elif defined(ROCMFP4_FAST_PLANAR)
         // This opt-in pipeline is selected only for M=10752, K=2048.
         const uint nblocks = 688128;
         const uint scale_word = data_a_planar[(nblocks << 2) + (ib >> 2)];
