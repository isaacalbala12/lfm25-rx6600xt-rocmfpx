 static constexpr size_t ggml_vk_rocmfpx_fp6_disk_block_size = 26;
 static constexpr size_t ggml_vk_rocmfpx_fp6_expanded_block_size = 34;
+static constexpr size_t ggml_vk_rocmfp4_fast_disk_block_size = 17;
+static constexpr size_t ggml_vk_rocmfp4_fast_padded_block_size = 20;
+
+static bool ggml_vk_rocmfp4_fast_is_padded_gateup(const ggml_tensor * tensor) {
+    return vk_rocmfp4_fast_mmq_bk3_gateup_padded &&
+           tensor->type == GGML_TYPE_Q4_0_ROCMFP4_FAST &&
+           tensor->ne[0] == 2048 && tensor->ne[1] == 10752;
+}
+
+static void ggml_vk_rocmfp4_fast_expand_padded(uint8_t * dst, const uint8_t * src, size_t nblocks) {
+    for (size_t ib = 0; ib < nblocks; ++ib) {
+        const uint8_t * s = src + ib * ggml_vk_rocmfp4_fast_disk_block_size;
+        uint8_t * d = dst + ib * ggml_vk_rocmfp4_fast_padded_block_size;
+        memcpy(d, s, 16);
+        d[16] = s[16];
+        d[17] = d[18] = d[19] = 0;
+    }
+}
+
+static void ggml_vk_rocmfp4_fast_pack_padded(uint8_t * dst, const uint8_t * src, size_t nblocks) {
+    for (size_t ib = 0; ib < nblocks; ++ib) {
+        uint8_t * d = dst + ib * ggml_vk_rocmfp4_fast_disk_block_size;
+        const uint8_t * s = src + ib * ggml_vk_rocmfp4_fast_padded_block_size;
+        memcpy(d, s, 16);
+        d[16] = s[16];
+    }
+}
 
