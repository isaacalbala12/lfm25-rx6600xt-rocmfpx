     }
@@ -8353,6 +8390,51 @@ static void ggml_vk_rocmfpx_fp6_read_packed_range(vk_buffer& src, size_t tensor_
     memcpy(dst, packed.data() + offset - packed_offset, size);
 }
 
+static void ggml_vk_rocmfp4_fast_write_padded_range(vk_buffer& dst, size_t tensor_offset,
+                                                     const void * src, size_t offset, size_t size) {
+    GGML_ASSERT(size > 0);
+    const size_t first_block = offset / ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t end_offset = offset + size;
+    const size_t end_block = (end_offset + ggml_vk_rocmfp4_fast_disk_block_size - 1) /
+                             ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t nblocks = end_block - first_block;
+    const size_t packed_offset = first_block * ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t packed_size = nblocks * ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t expanded_offset = first_block * ggml_vk_rocmfp4_fast_padded_block_size;
+    const size_t expanded_size = nblocks * ggml_vk_rocmfp4_fast_padded_block_size;
+    std::vector<uint8_t> expanded(expanded_size);
+
+    if (offset == packed_offset && size == packed_size) {
+        ggml_vk_rocmfp4_fast_expand_padded(expanded.data(), (const uint8_t *) src, nblocks);
+    } else {
+        std::vector<uint8_t> packed(packed_size);
+        ggml_vk_buffer_read(dst, tensor_offset + expanded_offset, expanded.data(), expanded_size);
+        ggml_vk_rocmfp4_fast_pack_padded(packed.data(), expanded.data(), nblocks);
+        memcpy(packed.data() + offset - packed_offset, src, size);
+        ggml_vk_rocmfp4_fast_expand_padded(expanded.data(), packed.data(), nblocks);
+    }
+    ggml_vk_buffer_write(dst, tensor_offset + expanded_offset, expanded.data(), expanded_size);
+}
+
+static void ggml_vk_rocmfp4_fast_read_padded_range(vk_buffer& src, size_t tensor_offset,
+                                                    void * dst, size_t offset, size_t size) {
+    GGML_ASSERT(size > 0);
+    const size_t first_block = offset / ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t end_offset = offset + size;
+    const size_t end_block = (end_offset + ggml_vk_rocmfp4_fast_disk_block_size - 1) /
+                             ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t nblocks = end_block - first_block;
+    const size_t packed_offset = first_block * ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t packed_size = nblocks * ggml_vk_rocmfp4_fast_disk_block_size;
+    const size_t expanded_offset = first_block * ggml_vk_rocmfp4_fast_padded_block_size;
+    const size_t expanded_size = nblocks * ggml_vk_rocmfp4_fast_padded_block_size;
+    std::vector<uint8_t> expanded(expanded_size);
+    std::vector<uint8_t> packed(packed_size);
+    ggml_vk_buffer_read(src, tensor_offset + expanded_offset, expanded.data(), expanded_size);
+    ggml_vk_rocmfp4_fast_pack_padded(packed.data(), expanded.data(), nblocks);
+    memcpy(dst, packed.data() + offset - packed_offset, size);
+}
