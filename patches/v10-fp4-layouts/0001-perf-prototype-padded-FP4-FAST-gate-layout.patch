+        return (ggml_nbytes(tensor) / ggml_vk_rocmfp4_fast_disk_block_size) *
+               ggml_vk_rocmfp4_fast_padded_block_size;
+    }
     if (tensor->type == GGML_TYPE_Q6_0_ROCMFPX) {
