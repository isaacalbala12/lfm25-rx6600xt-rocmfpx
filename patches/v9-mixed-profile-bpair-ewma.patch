index 584a578..9e8d213 100644
--- a/extensions/rocmfpx-vulkan/backend/vulkan-shaders/mul_mmq_funcs.glsl
+++ b/extensions/rocmfpx-vulkan/backend/vulkan-shaders/mul_mmq_funcs.glsl
@@ -497,3 +497,21 @@ void block_b_to_registers(const uint ib) {
         cache_b.qs[iqs] = buf_b[ib].qs[iqs];
     }
 }
+
+#if defined(ROCMFP4_FAST_GATEUP_BPAIR) && defined(DATA_A_ROCMFP4_FAST)
+void block_b_to_registers_pair(const uint pair_idx, const uint ib) {
+    cache_b_pair[pair_idx].ds = buf_b[ib].ds;
+    [[unroll]] for (uint iqs = 0; iqs < BK / 4; iqs++) {
+        cache_b_pair[pair_idx].qs[iqs] = buf_b[ib].qs[iqs];
+    }
+}
+
+ACC_TYPE mmq_dot_product_pair(const uint ib_a, const uint pair_idx) {
+    int32_t q_sum = 0;
+    [[unroll]] for (uint iqs = 0; iqs < 8; iqs++) {
+        q_sum += dotPacked4x8EXT(cache_a[ib_a].qs[iqs], cache_b_pair[pair_idx].qs[iqs]);
+    }
+
+    return ACC_TYPE(float(q_sum) * float(cache_a[ib_a].d) * float(cache_b_pair[pair_idx].ds.x));
+}
+#endif
